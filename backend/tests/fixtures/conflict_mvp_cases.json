  "merge_rule": "Each case overrides only explicitly supplied default fields; current:null means no accepted fact. expected fields are normative. A gate failure prevents approval regardless of relationship.",
  "cases": [
    {"id": "m1_revision_approve", "expected": {"relationship": "REVISION", "decision": "APPROVE", "head": 2, "previous_state": "SUPERSEDED", "accepted_value": "2026-09-18", "external_operations": 0}},
    {"id": "m1_new_seed", "current": null, "candidate": {"value": "2026-09-17"}, "source": "Project Phoenix release 2026 Q3 UAT review is on 17 September 2026.", "evidence_quote": "UAT review is on 17 September 2026.", "expected_head_before_review": null, "expected": {"relationship": "NEW", "decision": "APPROVE", "head": 1, "accepted_value": "2026-09-17"}},
    {"id": "same_new_evidence", "candidate": {"value": "2026-09-17"}, "source": "Project Phoenix release 2026 Q3 UAT review remains on 17 September 2026.", "evidence_quote": "UAT review remains on 17 September 2026.", "expected": {"relationship": "SAME", "head": 1, "new_versions": 0, "new_evidence_links_after_validation": 1}},
    {"id": "same_evidence_retry", "candidate": {"value": "2026-09-17"}, "source": "Project Phoenix release 2026 Q3 UAT review remains on 17 September 2026.", "evidence_quote": "UAT review remains on 17 September 2026.", "evidence_already_linked": true, "expected": {"relationship": "SAME", "head": 1, "new_versions": 0, "new_evidence_links_after_validation": 0}},
    {"id": "incompatible_without_replacement", "source": "Project Phoenix release 2026 Q3 UAT review is on 18 September 2026.", "evidence_quote": "UAT review is on 18 September 2026.", "expected": {"relationship": "CONFLICT", "decision": "KEEP_UNRESOLVED", "head": 1, "warning": true}},
    {"id": "question_not_change", "candidate": {"modality": "QUESTION"}, "source": "Could we move Project Phoenix UAT review to 18 September 2026?", "evidence_quote": "Could we move Project Phoenix UAT review to 18 September 2026?", "expected": {"relationship": "UNCLEAR", "head": 1, "replacement_approval_allowed": false}},
    {"id": "delayed_old_reschedule", "current": {"version": 2, "value": "2026-09-20", "source_time": "2026-09-15T09:00:00+08:00"}, "expected_head_before_review": 2, "expected": {"relationship": "UNCLEAR", "head": 2, "replacement_approval_allowed": false, "reason": "17-to-18 message does not establish replacement of the accepted 20 date"}},
    {"id": "foreign_owner_reference", "candidate_owner": "user-b", "expected": {"gate": "NOT_FOUND", "head": 1, "cross_owner_context_items": 0}},
    {"id": "other_project_same_title", "candidate_project": "project-orion", "expected": {"relationship_in_candidate_project": "NEW", "head_in_phoenix": 1, "cross_project_comparisons": 0}},
    {"id": "unassigned_project", "candidate_project": null, "expected": {"relationship": "UNCLEAR", "head": 1, "requires_project_choice": true}},
    {"id": "other_recurring_occurrence", "candidate_identity": "uat_review:release_2026_q4", "expected": {"relationship_in_candidate_identity": "NEW", "head_in_q3": 1, "merge_occurrences": false}},
    {"id": "missing_year", "candidate": {"value": "18 September", "precision": "MONTH_DAY"}, "source": "UAT review moved to 18 September.", "evidence_quote": "UAT review moved to 18 September.", "expected": {"relationship": "UNCLEAR", "head": 1, "invent_year": false}},
    {"id": "unsupported_time_precision", "candidate": {"value": "2026-09-18T14:00:00", "precision": "LOCAL_DATETIME"}, "source": "UAT review moved to 18 September 2026 at 2 pm.", "evidence_quote": "UAT review moved to 18 September 2026 at 2 pm.", "expected": {"relationship": "UNCLEAR", "head": 1, "invent_timezone": false}},
    {"id": "unrelated_quote", "evidence_quote": "The office kitchen will close on Friday.", "expected": {"gate": "INVALID_EVIDENCE", "head": 1, "new_versions": 0}},
    {"id": "quote_present_but_unsupported_value", "candidate": {"value": "2026-09-21"}, "expected": {"gate": "UNSUPPORTED_CLAIM", "head": 1, "new_versions": 0}},
    {"id": "reject_revision", "expected": {"relationship": "REVISION", "decision": "REJECT", "head": 1, "candidate_state": "REJECTED"}},
    {"id": "edit_requires_recomparison", "edit": {"value": "2026-09-19"}, "expected": {"comparison_invalidated": true, "head": 1, "requires_new_evidence_or_user_assertion": true}},
    {"id": "stale_proposal_review", "review_expected_proposal_revision": 1, "actual_proposal_revision": 2, "expected": {"gate": "STALE_REVIEW", "head": 1, "new_versions": 0}},
    {"id": "stale_head_review", "review_expected_head": 1, "current": {"version": 2, "value": "2026-09-20"}, "expected_head_before_review": 2, "expected": {"gate": "STALE_HEAD", "head": 2, "new_versions": 0}},
    {"id": "source_changed_before_approval", "review_source_fingerprint": "revision-a", "actual_source_fingerprint": "revision-b", "expected": {"gate": "SOURCE_CHANGED", "head": 1}},
    {"id": "duplicate_approval", "same_idempotency_key_requests": 2, "expected": {"head": 2, "new_versions": 1, "same_result_returned": true}},
    {"id": "two_competing_approvals", "concurrent_candidates": ["2026-09-18", "2026-09-19"], "expected": {"successful_approvals": 1, "stale_head_responses": 1, "current_heads": 1}},
    {"id": "summary_only", "source": "The team discussed concerns about API integration.", "evidence_quote": "The team discussed concerns about API integration.", "expected": {"structured_facts": 0, "summary_approval_allowed": true, "head": 1}},
    {"id": "summary_approval_is_not_fact_approval", "extracted_fact_count": 3, "decision_target": "GENERAL_SUMMARY", "expected": {"approved_summaries": 1, "approved_facts": 0, "pending_facts": 3, "head": 1}},
    {"id": "extraction_failure", "provider_result": "TIMEOUT", "expected": {"gate": "RETRYABLE_PROCESSING_FAILURE", "classify_as_new": false, "head": 1, "raw_source_retained": true}},
    {"id": "future_effective_change", "candidate": {"effective_from": "2026-09-16"}, "review_date": "2026-09-12", "expected": {"relationship": "UNCLEAR", "head": 1, "reason": "M1 abstains until operational applicability rules exist"}},
    {"id": "remove_source", "operation": "REMOVE_FROM_KNOWACT", "expected": {"local_raw_source_exists": false, "approved_minimal_evidence_retained": true, "source_available": false, "google_original_changed": false}},
    {"id": "purge_source", "operation": "PURGE", "expected": {"related_content_copies": 0, "evidence_text_copies": 0, "embeddings": 0, "content_in_ai_logs": 0, "history_marker": "EVIDENCE_REMOVED", "google_original_changed": false}},
    {"id": "sync_reimport", "operation": "SYNC_AFTER_REMOVE", "expected": {"may_import_fresh_local_source": true, "automatic_fact_extractions": 0, "new_versions": 0}}
  ]
}
