{
  "schema_version": 1,
  "purpose": "Development acceptance scenarios. These are designed expectations, not measured engine results or a frozen evaluation holdout.",
  "defaults": {
    "owner": "user-a",
    "project": "project-phoenix",
    "identity": "uat_review:release_2026_q3",
    "fact_type": "MEETING_TIME",
    "precision": "DATE",
    "current": {"version": 1, "value": "2026-09-17", "status": "CURRENT", "source_time": "2026-09-10T09:00:00+08:00"},
    "candidate": {"value": "2026-09-18", "source_time": "2026-09-12T09:00:00+08:00", "modality": "ASSERTION"},
