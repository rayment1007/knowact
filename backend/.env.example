# KnowAct — backend environment variables
# Copy this file to `.env` and fill in your own values.
# All variables map to fields on `app.config.Settings`.
# NEVER commit a real `.env` (it is gitignored).

# --- General ----------------------------------------------------------------
APP_NAME="KnowAct"

# Runtime mode: DEVELOPMENT or PRODUCTION.
# Governs the AI provider failure policy:
#   DEVELOPMENT -> LLM failures may fall back to the deterministic mock provider.
#   PRODUCTION  -> LLM failures surface as a retriable 503 (no silent fallback).
MODE=DEVELOPMENT

# --- Database ---------------------------------------------------------------
# Local Docker (docker-compose.yml maps host port 5434):
DATABASE_URL=postgresql+psycopg://knowact_app:123@localhost:5434/knowact
#
# Managed PostgreSQL (e.g. Neon). Keep the `postgresql+psycopg://` scheme and
# require TLS. Copy the connection string from the provider dashboard and
# rewrite the scheme:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Seed data --------------------------------------------------------------
# Password assigned to the two demo users created by `python -m app.seed`.
# There is NO default: the seeder refuses to run until this is set, so a
# well-known password can never be baked into the repo or a deployment.
SEED_USER_PASSWORD=CHOOSE_A_STRONG_PASSWORD

# --- Authentication ---------------------------------------------------------
# The signed JWT is delivered as an HTTP-only cookie; client JavaScript never
# reads it. Generate a long random secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Cookie attributes. `Secure` requires HTTPS: keep false for http://localhost
# and set true in any deployed environment.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# --- AI provider ------------------------------------------------------------
# "mock" (deterministic, no key, used by the test suite) or "llm" (real model).
AI_PROVIDER=llm
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=            # override for OpenAI-compatible endpoints
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1500

# --- CORS -------------------------------------------------------------------
# JSON array of allowed browser origins. With the Vercel rewrite in front of
# the API the browser only ever talks to one origin, so this list only matters
# for local development.
CORS_ORIGINS=["http://localhost:5173"]

# --- Frontend (SPA) ---------------------------------------------------------
# Public origin of the single-page app. OAuth callbacks 302-redirect the browser
# back to a route under this base so the user lands in the SPA, not on JSON.
# In production set this to your Vercel domain, e.g. https://knowact.vercel.app
FRONTEND_BASE_URL=http://localhost:5173

# --- Google OAuth (Sign-In + Gmail + Calendar) ------------------------------
# OAuth 2.0 client credentials from your Google Cloud project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Public origin the callback URLs are built against. Locally this is the backend
# itself; in production (behind the Vercel rewrite) it is your Vercel domain, so
# that both of these are registered as Authorized redirect URIs in Google Cloud:
#   <base>/api/auth/google/callback
#   <base>/api/integrations/callback
GOOGLE_OAUTH_REDIRECT_BASE=http://localhost:8000

# --- Token encryption at rest -----------------------------------------------
# Fernet key used to encrypt OAuth access/refresh tokens before they are
# persisted. Only ciphertext is stored; plaintext is never logged or returned.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Document storage -------------------------------------------------------
# "local" keeps uploaded binaries on the filesystem (never in Postgres).
# NOTE: on platforms with an ephemeral filesystem (e.g. Render free tier) the
# original uploaded files are lost on restart. Extracted chunks and embeddings
# live in PostgreSQL, so document Q&A keeps working.
STORAGE_BACKEND=local
STORAGE_ROOT=./var/storage

# --- Embeddings -------------------------------------------------------------
# "mock" produces deterministic vectors with no API key (used by tests);
# "openai" uses the real embeddings API.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
OPENAI_API_KEY=sk-...
